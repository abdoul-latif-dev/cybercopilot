# ============================================================
# Configuration CyberCopilot — Copier ce fichier en .env
# ============================================================

# ─── LLM (priorité Claude, fallback OpenAI) ─────────────────
# Choisis UNE des deux options (ou les deux, Claude sera utilisé en priorité)

# Option 1 — Anthropic Claude (RECOMMANDÉ)
# Obtenir une clé : https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option 2 — OpenAI (fallback)
# Obtenir une clé : https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-key-here

# Modèle LLM (auto-détecté si non spécifié)
# Pour Claude : claude-sonnet-4-5, claude-haiku-4-5
# Pour OpenAI : gpt-4o-mini, gpt-4o
LLM_MODEL=claude-sonnet-4-5

# ─── Stockage ────────────────────────────────────────────────
DB_PATH=data/incidents.db
LOG_DIR=data/logs

# ─── Web App (production) ────────────────────────────────────
# SESSION_SECRET=  # généré auto, à définir manuellement en prod
# ENV=production   # active HTTPS-only cookies
